# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=
# Where the site runs: http://localhost:3000 locally, https://getbayline.app on Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local scripts only (migrations, seed, tests). Not needed on Vercel.
# Supabase → Connect → Session pooler → URI, with your database password filled in
SUPABASE_DB_URL=

# Wallet passes (optional until approved; see docs/SETUP.md sections 7 and 8). Base64-encoded PEM/JSON.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_BASE64=
APPLE_PASS_KEY_BASE64=
APPLE_WWDR_CERT_BASE64=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=
